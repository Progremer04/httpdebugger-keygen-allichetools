{
  "name": "httpdebugger-keygen",
  "version": "1.0.0",
  "description": "HTTP Debugger Pro Keygen — by Alliche Tools",
  "author": "Alliche Tools",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.example.httpdebuggerkeygen",
    "productName": "HTTPDebuggerKeygen",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "logo.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "asar": true,
    "files": [
      "main.js",
      "index.html",
      "logo-mascot.png",
      "logo-shield.png",
      "node_modules/**/*"
    ],
    "compression": "maximum"
  }
}